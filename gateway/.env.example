# Gateway configuration — EXAMPLE. Copy to gateway/.env for local Compose runs.
#
#   cp gateway/.env.example gateway/.env
#
# .env is gitignored. This file is not. Nothing here is a real secret: every key below is an obvious
# placeholder that fails the "is this a real key" eyeball test, because a plausible-looking dummy
# secret in Git is how a real one eventually gets committed next to it (rules.md R-34).
#
# Settings.model_config sets extra="forbid": an unrecognized variable stops startup. That is
# deliberate — a typo'd variable name would otherwise silently fall back to a default, and the tier
# would be misconfigured in a way nobody noticed until the demo.
#
# On aws-gpu NONE of the secret values below come from a file. They are injected by ECS from Secrets
# Manager (aws-setup-instructions.md section 8); the task definition carries `secrets`, not
# `environment`, for those three keys.

# ── tier ────────────────────────────────────────────────────────────────────────────────────────────
# local-cpu | aws-gpu. The tier is a VALUE, not a code branch (rules.md R-04).
DEPLOYMENT_PROFILE=local-cpu
# Must be CUDAExecutionProvider when DEPLOYMENT_PROFILE=aws-gpu — config.py refuses to start
# otherwise, because CPU-provider latency numbers attributed to the GPU tier are worse than no
# numbers (rules.md R-45).
EXECUTION_PROVIDER=CPUExecutionProvider

# ── identity ────────────────────────────────────────────────────────────────────────────────────────
# The local issuer is a RESTRICTED TEST HARNESS, not authentication. config.py refuses to start if an
# issuer containing "testidp"/"localhost"/"127.0.0.1" is combined with aws-gpu (rules.md R-05).
# On aws-gpu these become the Cognito user-pool issuer, its /.well-known/jwks.json, and the app
# client id.
JWT_ISSUER=https://testidp.localhost
JWT_JWKS_URL=http://testidp:8081/.well-known/jwks.json
JWT_AUDIENCE=sih26104-local
JWT_LEEWAY_SECONDS=30

# ── edge ────────────────────────────────────────────────────────────────────────────────────────────
# Comma-separated EXACT origins. Wildcards are rejected by a field validator. Under aws-gpu, http://
# origins are rejected too. Include the port: normalize_origin() only drops the scheme's default port.
ALLOWED_ORIGINS=https://app.localhost

# ── downstream ──────────────────────────────────────────────────────────────────────────────────────
# Compose service name locally; scorer.sih26104.local:50051 via Cloud Map on ECS.
SCORER_TARGET=scorer:50051
# Hard per-call deadline. A window that misses it is DROPPED and counted, never retried and never
# treated as low risk (design.md section 4.4). Raise for CPU-tier inference, which is slower.
SCORER_DEADLINE_MS=400
SCORER_MAX_CONCURRENCY=4
DATABASE_URL=postgresql://sih:local-dev-password-not-a-secret@postgres:5432/sih26104

# ── secrets (same logical names on both tiers; different providers) ─────────────────────────────────
# Minimum 32 characters, enforced by a validator. Generate real ones with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HMAC_KEY=PLACEHOLDER-call-ref-key-replace-me-locally-0000
TICKET_SIGNING_KEY=PLACEHOLDER-ticket-key-replace-me-locally-000000
# NEVER rotate this once any audit event exists. Rotation does not invalidate old rows — it makes
# every one of them fail verification, which is indistinguishable from tampering (rules.md R-31).
AUDIT_CHAIN_KEY=PLACEHOLDER-audit-chain-key-replace-me-locally-00

# ── policy ──────────────────────────────────────────────────────────────────────────────────────────
# Mounted, not baked into the image, so a threshold change does not need a rebuild and policy_sha256
# in the release manifest names a file someone can point at.
POLICY_BUNDLE_PATH=/policy/policy.yaml
CALIBRATION_PATH=/policy/calibration.json

# ── retention / tenancy ─────────────────────────────────────────────────────────────────────────────
AUDIT_RETENTION_DAYS=7
# Written on every audit row from Phase 1 so Phase 4 can enable row-level security without a
# backfill against rows that have no tenant (decision D-7).
TENANT_ID=demo-tenant

# ── operational ─────────────────────────────────────────────────────────────────────────────────────
# At capacity, new streams are REFUSED, never queued: a queued audio stream produces a decision about
# a moment that has already passed (rules.md R-20).
MAX_CONCURRENT_STREAMS=4
LOG_LEVEL=INFO
# Injected by CI from the build SHA. Part of the parity set printed at startup; "unknown" in the
# banner means the running image cannot be traced to a commit.
GIT_COMMIT=unknown
